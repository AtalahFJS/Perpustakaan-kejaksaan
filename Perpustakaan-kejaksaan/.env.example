APP_NAME="PustakaAI"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- PostgreSQL + pgvector (PRD 7.2) ---
# Skema memakai tsvector dan tipe vector, jadi PostgreSQL wajib -- bukan SQLite.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=pustakaai
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
# F-1.3: sesi berakhir otomatis setelah 60 menit tidak aktif
SESSION_LIFETIME=60
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log

# Berkas dokumen disimpan di storage/app/private -- tidak dapat diakses
# langsung dari web server (NFR 6.2). Akses hanya lewat BerkasController.
FILESYSTEM_DISK=local

# --- Antrean ingest (PRD 7.2: Redis + Worker) ---
QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@pustakaai.local"
MAIL_FROM_NAME="${APP_NAME}"

# --- Layanan AI (FastAPI) ---
# AI_SERVICE_TOKEN harus sama dengan INTERNAL_TOKEN di ai-service/.env
AI_SERVICE_URL=http://127.0.0.1:8001
AI_SERVICE_TOKEN=ubah-dengan-nilai-acak-yang-kuat
AI_SERVICE_TIMEOUT=900

# --- Batas & kuota (F-7.6, NFR 6.2) ---
AI_QUOTA_CHAT_PER_HARI=50
UPLOAD_MAX_MB=100

VITE_APP_NAME="${APP_NAME}"
