# --- Basis data (dibagi dengan aplikasi Laravel) ---
DATABASE_URL=postgresql://atalah@127.0.0.1:5432/pustakaai

# --- Token internal; harus sama dengan AI_SERVICE_TOKEN di .env Laravel ---
INTERNAL_TOKEN=rahasia-internal-ubah-di-produksi

# --- Penyedia LLM (NFR 6.6: dapat diganti tanpa deploy ulang) ---
# Pilihan: deepseek | anthropic | palsu
#   deepseek  -- API DeepSeek, kompatibel OpenAI
#   anthropic -- Claude
#   palsu     -- mode uji tanpa LLM; seluruh alur tetap jalan tanpa biaya
LLM_PROVIDER=deepseek

# deepseek-chat (V3) atau deepseek-reasoner (R1, lebih lambat).
LLM_MODEL=deepseek-chat

# Ambil kuncinya di https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Suhu rendah karena tugasnya menyarikan isi kutipan, bukan mengarang.
LLM_TEMPERATURE=0.3

# Kedalaman penalaran. Hanya dipakai penyedia Anthropic; DeepSeek
# menentukannya lewat pilihan model, bukan parameter permintaan.
LLM_EFFORT_CHAT=low
LLM_EFFORT_RINGKASAN=medium

# Tarif per juta token untuk laporan estimasi biaya (F-7.3), dalam USD.
# WAJIB dicocokkan dengan halaman harga penyedia yang sedang dipakai.
LLM_HARGA_INPUT_PER_JUTA=0.28
LLM_HARGA_OUTPUT_PER_JUTA=0.42

# Kunci Anthropic, dipakai hanya bila LLM_PROVIDER=anthropic.
ANTHROPIC_API_KEY=

# --- Model embedding lokal (PRD 7.3: embedding dijalankan lokal) ---
# R9: model multibahasa agar kualitas jawaban dokumen Bahasa Indonesia baik.
EMBEDDING_MODEL=intfloat/multilingual-e5-base
EMBEDDING_DIMENSI=768
EMBEDDING_BATCH=32

# --- Pemotongan teks (PRD 7.5 langkah 6) ---
UKURAN_POTONGAN=600
TUMPANG_TINDIH=80

# --- Pengambilan potongan saat chat (PRD 7.6 langkah 4) ---
JUMLAH_POTONGAN_DIAMBIL=8

# --- Penyimpanan sampul, relatif terhadap storage/app/private milik Laravel ---
LARAVEL_STORAGE_PATH=../Perpustakaan-kejaksaan/storage/app/private

# OCR (opsional). Dinonaktifkan otomatis bila tesseract tidak terpasang.
OCR_AKTIF=true
OCR_BAHASA=ind+eng
